# ============================================================================
# Git Ignore Configuration for TelePilot (telegram-ai-client)
# ============================================================================

# Environment variables & local secrets
.env
.env.*
!.env.example
*.env

# Local Telegram session data, MTProto auth keys, QR codes & caches
/data/
*.session
*.session-journal
*.db
*.db-journal
*.sqlite
*.sqlite3
telegram_login_qr.png

# User chat exports, personal voice notes, screenshots & summary reports
/exports/

# Compiled Go binaries and build artifacts
/bin/
/telepilot
/tgp
.venv/


# macOS system & directory indexing metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows / generic thumbnail caches
ehthumbs.db
Thumbs.db

# Go test / coverage / profile outputs
*.test
*.out
*.prof
