# ============================================================================
# Telegram MTProto Credentials (get yours from https://my.telegram.org/apps)
# ============================================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_ai_user

# Optional: Private Bot Token (from @BotFather) if you want a dedicated bot chat
# Leave empty to use your own "Saved Messages" for /sum and /chats commands
TELEGRAM_BOT_TOKEN=

# ============================================================================
# Cloud AI Model Configuration
# ============================================================================
# Primary Provider: "gemini" (recommended for native voice/image/PDF) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ============================================================================
# Default Summarization Settings
# ============================================================================
# Default period when parsing chats (e.g. "1m" = 1 month / 30 days, "7d", "2w", "3m")
DEFAULT_PERIOD=1m

# Active summary skill in .agents/skills/ (e.g. "period-summary", "standup-digest", "decisions-log")
DEFAULT_SKILL=period-summary

# Optional extra run notes appended to the summary skill on each run
DEFAULT_NOTES=

# Application UI & Skills preferred language ("en" by default or "ru")
APP_LANGUAGE=en

# Legacy fallback (deprecated, superseded by DEFAULT_SKILL + DEFAULT_NOTES)
# DEFAULT_PROMPT=...

# Root directory for period folders (images/, documents/, voice/, summary.md)
EXPORTS_DIR=exports

